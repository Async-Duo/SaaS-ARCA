# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Output directory (si usas TypeScript para compilar)
dist/
build/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 🔐 CLAVES Y CERTIFICADOS (OpenSSL, ARCA/AFIP, JWT)
# Evita subir por error la clave privada o el pedido de certificado
*.key
*.csr
*.crt
*.pem
*.pfx
*.p12

# ◭ PRISMA & ENTORNOS
# Nunca subir las credenciales de la base de datos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de respaldo de SQLite (si la usas para desarrollo local)
*.db
*.db-journal
